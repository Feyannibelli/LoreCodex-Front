# Vite env vars must be prefixed with `VITE_`.
# Copy this file to `.env` (do NOT commit `.env` with real secrets).

# Backend base URL
VITE_API_URL=http://localhost:8081

# Auth0 (SPA) - DO NOT set client secret in the frontend
VITE_AUTH0_DOMAIN=dev-ylhiqy1yjkj1aw7e.us.auth0.com
VITE_AUTH0_CLIENT_ID=orNjwhOnOgpDWnB9QlBjNWHmmrIMlobX
VITE_AUTH0_AUDIENCE=https://api.lorecodex.com
VITE_AUTH0_SCOPE=openid profile email
VITE_AUTH0_REDIRECT_URI=http://localhost:5173

# Roles claim in the access token (comma-separated fallbacks supported)
# Common Auth0 pattern is a namespaced custom claim set by an Action:
# - https://api.lorecodex.com/roles
VITE_AUTH0_ROLES_CLAIM=https://api.lorecodex.com/roles,roles

